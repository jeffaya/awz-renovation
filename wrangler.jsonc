{
  "name": "awz-renovation",
  "compatibility_date": "2024-09-25",
  "main": "worker.mjs",
  "workers_dev": true,
  "routes": [{ "pattern": "awz-renovation.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "html_handling": "none",
  },
}
